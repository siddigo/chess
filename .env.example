# Copie para .env para rodar localmente conectado ao Supabase.
# Sem .env, o app roda 100% local (dados em data/dev-games.json).
# Na Vercel, cadastre estas mesmas variáveis em Settings → Environment Variables.

# Project Settings → API (ou "API Keys") no painel do Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave pública: "anon" (legacy) ou "publishable" (sb_publishable_...)
SUPABASE_ANON_KEY=
# Chave secreta: "service_role" (legacy) ou "secret" (sb_secret_...). NUNCA exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Senha para apagar partidas do histórico
ADMIN_PASSWORD=

# Só local, para npm run db:setup (Supabase → Connect → Session pooler). Acesso total ao banco!
SUPABASE_DB_URL=
