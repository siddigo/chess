{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "git": { "deploymentEnabled": { "main": false } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?path=:path*" },
    { "source": "/game/:id", "destination": "/game.html" },
    { "source": "/replay/:id", "destination": "/replay.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/ao-vivo", "destination": "/live.html" }
  ]
}
